{
  "name": "shamar",
  "private": true,
  "description": "Filament-inspired admin panel for AdonisJS — @shamar monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter './packages/*' test",
    "dev": "pnpm --parallel --filter @shamar/playground --filter @shamar/adonis run dev",
    "dev:app": "pnpm --filter @shamar/playground dev",
    "docs:dev": "pnpm --filter @shamar/docs dev",
    "docs:build": "pnpm --filter @shamar/docs build",
    "site:sync": "node scripts/sync-site-to-playground.mjs",
    "site:build": "PUBLIC_DEMO_URL= pnpm docs:build && pnpm site:sync",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose --profile dev up -d --build",
    "docker:prod": "docker compose --profile prod up -d --build"
  },
  "license": "MIT"
}
