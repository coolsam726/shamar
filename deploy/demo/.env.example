# Copy to /opt/shamar/.env and fill in. Never commit the real file.
HOST=0.0.0.0
PORT=3333
NODE_ENV=production
LOG_LEVEL=info
SESSION_DRIVER=cookie

# openssl rand -base64 32
APP_KEY=

# Public URL of this panel (Cloudflare → VPS)
APP_URL=https://demo.shamar.dev

# Leave unset to use the Compose mongo service. Or point at Atlas:
# MONGO_URI=mongodb+srv://…

SHAMAR_DEMO_MODE=true
# openssl rand -hex 24
DEMO_RESET_TOKEN=
# CORS for demo-status from the docs site
DEMO_DOCS_ORIGIN=https://shamar.dev

# Image tag pulled by Compose (release tag or latest)
IMAGE_TAG=latest

# Optional — only needed if the GHCR package is private
# Create a classic PAT with read:packages, or use a fine-grained token.
# GHCR_USER=coolsam726
# GHCR_TOKEN=
