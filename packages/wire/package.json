{
  "name": "@shamar/wire",
  "version": "1.0.0",
  "description": "Server-driven reactive components. Usable on its own or inside a Shamar admin panel.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/coolsam726/shamar.git",
    "directory": "packages/wire"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
