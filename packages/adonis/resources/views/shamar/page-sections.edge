@include('shamar::partials/shell-open')

<div
  class="mx-auto space-y-8 {{ contentMaxWidthClass || 'w-full max-w-screen-xl' }}"
  @if(contentMaxWidthStyle)
    style="{{ contentMaxWidthStyle }}"
  @endif
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-heading tracking-tight">{{ pageTitle }}</h1>
      @if(pageSubtitle)
        <p class="mt-1 text-sm text-body-subtle">{{ pageSubtitle }}</p>
      @endif
    </div>
    @if(pageActions && pageActions.length)
      <div class="flex flex-wrap items-center gap-2">
        @each(action in pageActions)
          <form method="post" action="{{ basePath }}/{{ page.slug }}/action/{{ action.name }}">
            @include('shamar::partials/csrf')
            <button
              type="submit"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md border border-default text-body hover:bg-surface-hover transition {{ action.color === 'danger' ? 'text-red-600 border-red-200' : '' }}"
              @if(action.confirm)
                onclick="return confirm({{ JSON.stringify(action.confirm) }})"
              @endif
            >{{ action.label }}</button>
          </form>
        @endeach
      </div>
    @endif
  </div>

  @each(section in pageSections)
    @if(section.title)
      <div class="space-y-3">
        <h2 class="text-base font-semibold text-heading">{{ section.title }}</h2>
        @if(section.kind === 'edge')
          @include('shamar::partials/page-section-edge')
        @elseif(section.kind === 'form')
          @include('shamar::partials/page-section-form')
        @elseif(section.kind === 'table')
          @include('shamar::partials/page-section-table')
        @elseif(section.kind === 'infolist')
          @include('shamar::partials/page-section-infolist')
        @endif
      </div>
    @else
      @if(section.kind === 'edge')
        @include('shamar::partials/page-section-edge')
      @elseif(section.kind === 'form')
        @include('shamar::partials/page-section-form')
      @elseif(section.kind === 'table')
        @include('shamar::partials/page-section-table')
      @elseif(section.kind === 'infolist')
        @include('shamar::partials/page-section-infolist')
      @endif
    @endif
  @endeach
</div>

@include('shamar::partials/shell-close')
