@include('shamar::partials/shell-open')

<div
  class="mx-auto space-y-6 {{ contentMaxWidthClass || 'w-full max-w-screen-xl' }}"
  @if(contentMaxWidthStyle)
    style="{{ contentMaxWidthStyle }}"
  @endif
>
  @if(content)
    {{{ content }}}
  @else
    <div class="shamar-card rounded-xl p-6 text-sm text-body-subtle">
      <p>This page has no custom content. Override <code>static view</code> or pass <code>content</code> from <code>mount()</code>.</p>
    </div>
  @endif
</div>

@include('shamar::partials/shell-close')
