@include('shamar::partials/shell-open')

<div
  class="shamar-media"
  tabindex="0"
  x-data="shamarMediaManager({
    apiBase: {{ jsonAttr(mediaApiBase) }},
    folderId: {{ jsonAttr(folder ? folder.id : null) }},
    folders: {{ jsonAttr(folders) }},
    folderTree: {{ jsonAttr(folderTree ?? []) }},
    files: {{ jsonAttr(files) }},
    breadcrumbs: {{ jsonAttr(mediaBreadcrumbs) }},
  })"
  @keydown.window="onKeydown($event)"
>
  <div class="shamar-media__layout" :class="{ 'has-details': !!details }">
    {{-- Left: folder sidebar --}}
    <aside class="shamar-media__sidebar" aria-label="Folders">
      <div class="shamar-media__sidebar-head">
        <span class="shamar-media__sidebar-title">Folders</span>
        <button
          type="button"
          class="shamar-media__sidebar-add"
          @click="promptNewFolder(folderId)"
          title="New folder here"
          aria-label="New folder in current directory"
        >+</button>
      </div>
      <nav class="shamar-media__tree">
        <div
          class="shamar-media__tree-row"
          :class="{ 'is-active': !folderId, 'is-drop-target': dropTarget === 'root' }"
          @dragover.prevent="onDragOverTarget($event, 'root', null)"
          @dragleave.prevent="clearDropTarget()"
          @drop.prevent="onDropOnTarget($event, null)"
        >
          <span class="shamar-media__tree-twist is-leaf" aria-hidden="true"></span>
          <button
            type="button"
            class="shamar-media__tree-item"
            :class="{ 'is-active': !folderId }"
            @click="goFolder(null)"
          >
            <span class="shamar-media__tree-label">Library</span>
          </button>
        </div>
        <template x-for="node in treeNodes()" :key="node.id">
          <div
            class="shamar-media__tree-row"
            :class="{ 'is-active': folderId === node.id, 'is-drop-target': dropTarget === ('folder:' + node.id) }"
            :style="{ paddingLeft: (0.35 + node.depth * 0.85) + 'rem' }"
            @dragover.prevent="onDragOverTarget($event, 'folder:' + node.id, node.id)"
            @dragleave.prevent="clearDropTarget()"
            @drop.prevent="onDropOnTarget($event, node.id)"
          >
            <button
              type="button"
              class="shamar-media__tree-twist"
              :class="{ 'is-expanded': node.expanded, 'is-leaf': !node.hasChildren }"
              :disabled="!node.hasChildren"
              :aria-label="node.expanded ? 'Collapse' : 'Expand'"
              @click="toggleExpand(node.id, $event)"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12" aria-hidden="true">
                <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
              </svg>
            </button>
            <button
              type="button"
              class="shamar-media__tree-item"
              :class="{ 'is-active': folderId === node.id }"
              @click="goFolder(node.id)"
              @contextmenu.prevent="openMenu($event, 'folder', node)"
            >
              <span class="shamar-media__tree-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              </span>
              <span class="shamar-media__tree-label" x-text="node.name"></span>
            </button>
          </div>
        </template>
      </nav>
    </aside>

    {{-- Center: browse canvas --}}
    <div class="shamar-media__main">
      <div class="shamar-media__toolbar">
        <div class="shamar-media__crumbs">
          <a
            href="{{ basePath }}/media"
            class="shamar-media__crumb"
            :class="{ 'is-drop-target': dropTarget === 'root' }"
            @click.prevent="goFolder(null)"
            @dragover.prevent="onDragOverTarget($event, 'root', null)"
            @dragleave.prevent="clearDropTarget()"
            @drop.prevent="onDropOnTarget($event, null)"
          >Library</a>
          <template x-for="crumb in breadcrumbs" :key="crumb.id">
            <span class="shamar-media__crumb-wrap">
              <span class="shamar-media__crumb-sep" aria-hidden="true">/</span>
              <a
                href="#"
                class="shamar-media__crumb"
                :class="{ 'is-drop-target': dropTarget === ('folder:' + crumb.id) }"
                @click.prevent="goFolder(crumb.id)"
                @dragover.prevent="onDragOverTarget($event, 'folder:' + crumb.id, crumb.id)"
                @dragleave.prevent="clearDropTarget()"
                @drop.prevent="onDropOnTarget($event, crumb.id)"
                x-text="crumb.name"
              ></a>
            </span>
          </template>
        </div>
        <div class="shamar-media__actions">
          <div class="shamar-media__view-modes" role="group" aria-label="View mode">
            <button
              type="button"
              class="shamar-media__view-btn"
              :class="{ 'is-active': viewMode === 'icons' }"
              @click="setViewMode('icons')"
              title="Icons"
              aria-label="Icons view"
              :aria-pressed="viewMode === 'icons'"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 0h7v7h-7v-7z"/></svg>
            </button>
            <button
              type="button"
              class="shamar-media__view-btn"
              :class="{ 'is-active': viewMode === 'tiles' }"
              @click="setViewMode('tiles')"
              title="Tiles"
              aria-label="Tiles view"
              :aria-pressed="viewMode === 'tiles'"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm10 0a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2V5zM3 15a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6zm10 0a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-6z"/></svg>
            </button>
            <button
              type="button"
              class="shamar-media__view-btn"
              :class="{ 'is-active': viewMode === 'list' }"
              @click="setViewMode('list')"
              title="List"
              aria-label="List view"
              :aria-pressed="viewMode === 'list'"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/></svg>
            </button>
            <button
              type="button"
              class="shamar-media__view-btn"
              :class="{ 'is-active': viewMode === 'details' }"
              @click="setViewMode('details')"
              title="Details"
              aria-label="Details view"
              :aria-pressed="viewMode === 'details'"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M4 6h10v2H4V6zm0 5h16v2H4v-2zm0 5h12v2H4v-2zM16 6h4v2h-4V6z"/></svg>
            </button>
          </div>
          <label class="shamar-btn shamar-btn--primary">
            Upload
            <input type="file" class="sr-only" multiple @change="onUpload($event)" />
          </label>
          <button type="button" class="shamar-btn shamar-btn--secondary" @click="promptNewFolder(folderId)">New folder</button>
          <button
            type="button"
            class="shamar-btn shamar-btn--ghost"
            x-show="clipboard"
            @click="pasteHere()"
            x-text="clipboard && clipboard.mode === 'cut' ? 'Move here' : 'Paste here'"
          ></button>
        </div>
      </div>

      <div class="shamar-media__bulk" x-show="selection.length" x-cloak>
        <span class="shamar-media__bulk-label" x-text="selectionLabel()"></span>
        <div class="shamar-media__bulk-actions">
          <button type="button" class="shamar-btn shamar-btn--ghost" @click="cutItem()">Cut</button>
          <button type="button" class="shamar-btn shamar-btn--ghost" x-show="selectedFiles().length" @click="copyItem()">Copy</button>
          <button type="button" class="shamar-btn shamar-btn--ghost" x-show="selectedFiles().length" @click="bulkSetVisibility('public')">Make public</button>
          <button type="button" class="shamar-btn shamar-btn--ghost" x-show="selectedFiles().length" @click="bulkSetVisibility('private')">Make private</button>
          <button type="button" class="shamar-btn shamar-btn--ghost is-danger" @click="bulkDelete()">Delete</button>
          <button type="button" class="shamar-btn shamar-btn--ghost" @click="clearSelection()">Clear</button>
        </div>
      </div>

      <p class="shamar-media__hint" x-show="clipboard" x-cloak>
        <span x-text="clipboardLabel()"></span>
        <button type="button" class="shamar-media__hint-clear" @click="clearClipboard()">Clear</button>
      </p>

      <div
        class="shamar-media__drop"
        :class="{ 'is-dragover': dragover === 'upload' || dragover === 'move' }"
        @dragover.prevent="onCanvasDragOver($event)"
        @dragleave.prevent="onCanvasDragLeave($event)"
        @drop.prevent="onCanvasDrop($event)"
        @contextmenu.prevent="openEmptyMenu($event)"
        @click.self="clearSelection()"
      >
        <p class="shamar-media__drop-hint" x-show="dragover === 'upload'" x-cloak>Drop files to upload</p>
        <p class="shamar-media__drop-hint" x-show="dragover === 'move'" x-cloak>Drop to move here</p>

        {{-- Icons / thumbnails --}}
        <div class="shamar-media__grid" x-show="viewMode === 'icons' && (folders.length || files.length)">
          <template x-for="item in folders" :key="'f-' + item.id">
            <button
              type="button"
              class="shamar-media__tile is-folder"
              :class="{
                'is-selected': isItemSelected('folder', item.id),
                'is-cut': isCutItem('folder', item.id),
                'is-drop-target': dropTarget === ('folder:' + item.id),
              }"
              draggable="true"
              @click="onItemClick($event, 'folder', item)"
              @dblclick="goFolder(item.id)"
              @contextmenu.prevent="openMenu($event, 'folder', item)"
              @dragstart="onDragStart($event, 'folder', item)"
              @dragend="onDragEnd()"
              @dragover.prevent="onDragOverTarget($event, 'folder:' + item.id, item.id)"
              @dragleave.prevent="clearDropTarget()"
              @drop.prevent.stop="onDropOnTarget($event, item.id)"
            >
              <span class="shamar-media__tile-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="36" height="36"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              </span>
              <span class="shamar-media__tile-name" x-text="item.name"></span>
            </button>
          </template>

          <button
            type="button"
            class="shamar-media__tile is-folder is-quick-add"
            @click="promptNewFolder(folderId)"
            title="Create a folder here"
          >
            <span class="shamar-media__tile-icon" aria-hidden="true">+</span>
            <span class="shamar-media__tile-name">New folder</span>
          </button>

          <template x-for="item in files" :key="'file-' + item.id">
            <button
              type="button"
              class="shamar-media__tile"
              :class="{
                'is-selected': isItemSelected('file', item.id),
                'is-cut': isCutItem('file', item.id),
              }"
              draggable="true"
              @click="onItemClick($event, 'file', item)"
              @dblclick="openDetails(item)"
              @contextmenu.prevent="openMenu($event, 'file', item)"
              @dragstart="onDragStart($event, 'file', item)"
              @dragend="onDragEnd()"
            >
              <span class="shamar-media__tile-preview">
                <template x-if="item.isImage">
                  <img :src="item.url" :alt="item.name" draggable="false" />
                </template>
                <template x-if="!item.isImage">
                  <span class="shamar-media__tile-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="36" height="36"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                  </span>
                </template>
              </span>
              <span class="shamar-media__tile-name" x-text="item.name"></span>
              <span class="shamar-media__badge" x-show="item.visibility === 'public'" x-cloak>Public</span>
            </button>
          </template>
        </div>

        {{-- Tiles view --}}
        <div class="shamar-media__grid shamar-media__grid--tiles" x-show="viewMode === 'tiles' && (folders.length || files.length)">
          <template x-for="row in sortedBrowseItems()" :key="'t-' + row.key">
            <button
              type="button"
              class="shamar-media__tile"
              :class="{
                'is-folder': row.kind === 'folder',
                'is-selected': isItemSelected(row.kind, row.item.id),
                'is-cut': isCutItem(row.kind, row.item.id),
                'is-drop-target': row.kind === 'folder' && dropTarget === ('folder:' + row.item.id),
              }"
              draggable="true"
              @click="onItemClick($event, row.kind, row.item)"
              @dblclick="row.kind === 'folder' ? goFolder(row.item.id) : openDetails(row.item)"
              @contextmenu.prevent="openMenu($event, row.kind, row.item)"
              @dragstart="onDragStart($event, row.kind, row.item)"
              @dragend="onDragEnd()"
              @dragover.prevent="row.kind === 'folder' ? onDragOverTarget($event, 'folder:' + row.item.id, row.item.id) : null"
              @dragleave.prevent="row.kind === 'folder' ? clearDropTarget() : null"
              @drop.prevent.stop="row.kind === 'folder' ? onDropOnTarget($event, row.item.id) : null"
            >
              <span class="shamar-media__tile-preview">
                <template x-if="row.kind === 'folder'">
                  <span class="shamar-media__tile-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                  </span>
                </template>
                <template x-if="row.kind === 'file' && row.item.isImage">
                  <img :src="row.item.url" :alt="row.item.name" draggable="false" />
                </template>
                <template x-if="row.kind === 'file' && !row.item.isImage">
                  <span class="shamar-media__tile-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                  </span>
                </template>
              </span>
              <span class="shamar-media__tile-name" x-text="row.item.name"></span>
              <span class="shamar-media__tile-meta" x-show="row.kind === 'file'" x-text="humanSize(row.item.size)"></span>
              <span class="shamar-media__tile-meta" x-show="row.kind === 'folder'">Folder</span>
              <span class="shamar-media__badge" x-show="row.kind === 'file' && row.item.visibility === 'public'" x-cloak>Public</span>
            </button>
          </template>
        </div>

        {{-- List view --}}
        <div class="shamar-media__list" x-show="viewMode === 'list' && (folders.length || files.length)" role="list">
          <template x-for="row in sortedBrowseItems()" :key="'l-' + row.key">
            <button
              type="button"
              class="shamar-media__list-row"
              :class="{
                'is-folder': row.kind === 'folder',
                'is-selected': isItemSelected(row.kind, row.item.id),
                'is-cut': isCutItem(row.kind, row.item.id),
                'is-drop-target': row.kind === 'folder' && dropTarget === ('folder:' + row.item.id),
              }"
              role="listitem"
              draggable="true"
              @click="onItemClick($event, row.kind, row.item)"
              @dblclick="row.kind === 'folder' ? goFolder(row.item.id) : openDetails(row.item)"
              @contextmenu.prevent="openMenu($event, row.kind, row.item)"
              @dragstart="onDragStart($event, row.kind, row.item)"
              @dragend="onDragEnd()"
              @dragover.prevent="row.kind === 'folder' ? onDragOverTarget($event, 'folder:' + row.item.id, row.item.id) : null"
              @dragleave.prevent="row.kind === 'folder' ? clearDropTarget() : null"
              @drop.prevent.stop="row.kind === 'folder' ? onDropOnTarget($event, row.item.id) : null"
            >
              <span class="shamar-media__list-icon" aria-hidden="true">
                <template x-if="row.kind === 'folder'">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                </template>
                <template x-if="row.kind === 'file' && row.item.isImage">
                  <img :src="row.item.url" :alt="row.item.name" draggable="false" />
                </template>
                <template x-if="row.kind === 'file' && !row.item.isImage">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                </template>
              </span>
              <span class="shamar-media__list-name" x-text="row.item.name"></span>
              <span class="shamar-media__list-meta" x-text="row.kind === 'folder' ? 'Folder' : humanSize(row.item.size)"></span>
            </button>
          </template>
        </div>

        {{-- Details / columns view --}}
        <div class="shamar-media__table-wrap" x-show="viewMode === 'details' && (folders.length || files.length)">
          <table class="shamar-media__table">
            <thead>
              <tr>
                <th scope="col">
                  <button type="button" class="shamar-media__sort" :class="{ 'is-active': isSorted('name') }" @click="toggleSort('name')">
                    Name <span class="shamar-media__sort-indicator" x-text="sortIndicator('name')"></span>
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="shamar-media__sort" :class="{ 'is-active': isSorted('type') }" @click="toggleSort('type')">
                    Type <span class="shamar-media__sort-indicator" x-text="sortIndicator('type')"></span>
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="shamar-media__sort" :class="{ 'is-active': isSorted('size') }" @click="toggleSort('size')">
                    Size <span class="shamar-media__sort-indicator" x-text="sortIndicator('size')"></span>
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="shamar-media__sort" :class="{ 'is-active': isSorted('visibility') }" @click="toggleSort('visibility')">
                    Visibility <span class="shamar-media__sort-indicator" x-text="sortIndicator('visibility')"></span>
                  </button>
                </th>
              </tr>
            </thead>
            <tbody>
              <template x-for="row in sortedBrowseItems()" :key="'d-' + row.key">
                <tr
                  class="shamar-media__table-row"
                  :class="{
                    'is-folder': row.kind === 'folder',
                    'is-selected': isItemSelected(row.kind, row.item.id),
                    'is-cut': isCutItem(row.kind, row.item.id),
                    'is-drop-target': row.kind === 'folder' && dropTarget === ('folder:' + row.item.id),
                  }"
                  draggable="true"
                  @click="onItemClick($event, row.kind, row.item)"
                  @dblclick="row.kind === 'folder' ? goFolder(row.item.id) : openDetails(row.item)"
                  @contextmenu.prevent="openMenu($event, row.kind, row.item)"
                  @dragstart="onDragStart($event, row.kind, row.item)"
                  @dragend="onDragEnd()"
                  @dragover.prevent="row.kind === 'folder' ? onDragOverTarget($event, 'folder:' + row.item.id, row.item.id) : null"
                  @dragleave.prevent="row.kind === 'folder' ? clearDropTarget() : null"
                  @drop.prevent.stop="row.kind === 'folder' ? onDropOnTarget($event, row.item.id) : null"
                >
                  <td>
                    <span class="shamar-media__table-name">
                      <span class="shamar-media__list-icon" aria-hidden="true">
                        <template x-if="row.kind === 'folder'">
                          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                        </template>
                        <template x-if="row.kind === 'file' && row.item.isImage">
                          <img :src="row.item.url" :alt="row.item.name" draggable="false" />
                        </template>
                        <template x-if="row.kind === 'file' && !row.item.isImage">
                          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                        </template>
                      </span>
                      <span x-text="row.item.name"></span>
                    </span>
                  </td>
                  <td x-text="row.kind === 'folder' ? 'Folder' : fileTypeLabel(row.item)"></td>
                  <td x-text="row.kind === 'folder' ? '—' : humanSize(row.item.size)"></td>
                  <td x-text="row.kind === 'folder' ? '—' : (row.item.visibility === 'public' ? 'Public' : 'Private')"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>

        <div class="shamar-media__empty" x-show="!folders.length && !files.length" x-cloak>
          <p>This folder is empty.</p>
          <p class="text-body-subtle text-sm">Upload, paste, or create a folder to get started.</p>
          <button type="button" class="shamar-btn shamar-btn--secondary" @click="promptNewFolder(folderId)">New folder</button>
        </div>
      </div>

      <p class="shamar-media__status" x-show="status" x-text="status" x-cloak></p>
    </div>

    {{-- Right: file details pane (explorer-style) --}}
    <aside
      class="shamar-media__details"
      x-show="details"
      x-cloak
    >
      <template x-if="details">
        <div class="shamar-media__details-inner">
          <header class="shamar-media__details-head">
            <span class="shamar-media__details-head-label">Details</span>
            <button type="button" class="shamar-media__details-close" @click="closeDetails()" aria-label="Close details">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/></svg>
            </button>
          </header>

          <div class="shamar-media__details-hero">
            <div class="shamar-media__details-preview">
              <img x-show="details.isImage" :src="details.url" :alt="details.name" />
              <div x-show="!details.isImage" class="shamar-media__details-fileicon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="56" height="56"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                <span class="shamar-media__details-ext" x-show="fileExtension(details.name)" x-text="fileExtension(details.name)"></span>
              </div>
            </div>
            <h3 class="shamar-media__details-title" x-text="details.name"></h3>
            <p class="shamar-media__details-subtitle">
              <span x-text="fileTypeLabel(details)"></span>
              <span aria-hidden="true"> · </span>
              <span x-text="humanSize(details.size)"></span>
            </p>
          </div>

          <section class="shamar-media__details-section" aria-label="File properties">
            <h4 class="shamar-media__details-section-title">Properties</h4>
            <dl class="shamar-media__props">
              <div class="shamar-media__prop-row">
                <dt class="shamar-media__prop-label">Name</dt>
                <dd class="shamar-media__prop-value" x-text="details.name"></dd>
              </div>
              <div class="shamar-media__prop-row">
                <dt class="shamar-media__prop-label">Type</dt>
                <dd class="shamar-media__prop-value" x-text="details.mime || '—'"></dd>
              </div>
              <div class="shamar-media__prop-row">
                <dt class="shamar-media__prop-label">Size</dt>
                <dd class="shamar-media__prop-value">
                  <span x-text="humanSize(details.size)"></span>
                  <span class="shamar-media__prop-muted" x-text="'(' + humanSizeExact(details.size) + ')'"></span>
                </dd>
              </div>
              <div class="shamar-media__prop-row" x-show="detailsDimensions()" x-cloak>
                <dt class="shamar-media__prop-label">Dimensions</dt>
                <dd class="shamar-media__prop-value" x-text="detailsDimensions()"></dd>
              </div>
              <div class="shamar-media__prop-row">
                <dt class="shamar-media__prop-label">Folder</dt>
                <dd class="shamar-media__prop-value" x-text="detailsLocation()"></dd>
              </div>
              <div class="shamar-media__prop-row" x-show="details.createdAt" x-cloak>
                <dt class="shamar-media__prop-label">Created</dt>
                <dd class="shamar-media__prop-value" x-text="formatDate(details.createdAt)"></dd>
              </div>
              <div class="shamar-media__prop-row" x-show="details.updatedAt" x-cloak>
                <dt class="shamar-media__prop-label">Modified</dt>
                <dd class="shamar-media__prop-value" x-text="formatDate(details.updatedAt)"></dd>
              </div>
            </dl>
          </section>

          <section class="shamar-media__details-section" aria-label="Access">
            <h4 class="shamar-media__details-section-title">Access</h4>
            <dl class="shamar-media__props">
              <div class="shamar-media__prop-row">
                <dt class="shamar-media__prop-label">Visibility</dt>
                <dd class="shamar-media__prop-value">
                  <span
                    class="shamar-media__details-badge"
                    :class="details.visibility === 'public' ? 'is-public' : 'is-private'"
                    x-text="details.visibility === 'public' ? 'Public' : 'Private'"
                  ></span>
                </dd>
              </div>
              <div class="shamar-media__prop-row shamar-media__prop-row--stack">
                <dt class="shamar-media__prop-label">URL</dt>
                <dd class="shamar-media__prop-value">
                  <code class="shamar-media__details-url" x-text="details.url"></code>
                  <button type="button" class="shamar-media__details-copy" @click="copyDetailsUrl()">Copy</button>
                </dd>
              </div>
            </dl>
          </section>

          <footer class="shamar-media__details-foot">
            <a class="shamar-btn shamar-btn--primary" :href="details.url" target="_blank" rel="noopener">Open</a>
            <button
              type="button"
              class="shamar-btn shamar-btn--secondary"
              @click="setVisibility(details.visibility === 'public' ? 'private' : 'public')"
              x-text="details.visibility === 'public' ? 'Make private' : 'Make public'"
            ></button>
          </footer>
        </div>
      </template>
    </aside>
  </div>

  <template x-teleport="body">
    <div
      class="shamar-media__menu"
      x-show="menu.open"
      x-cloak
      x-bind:style="menu.style"
      @click.outside="onMenuOutside()"
      @contextmenu.outside.prevent="onMenuOutside()"
      role="menu"
    >
      <button type="button" role="menuitem" x-show="menu.kind === 'file'" @click="openDetailsFromMenu()">Details</button>
      <button type="button" role="menuitem" x-show="menu.kind === 'file'" @click="openFromMenu()">Open in new tab</button>
      <button type="button" role="menuitem" x-show="menu.kind === 'folder'" @click="openFromMenu()">Open</button>
      <button
        type="button"
        role="menuitem"
        x-show="menu.kind === 'folder'"
        @click="promptNewFolder(menu.item && menu.item.id); closeMenu()"
      >New subfolder</button>
      <button type="button" role="menuitem" x-show="menu.kind || selection.length" @click="cutItem()">Cut</button>
      <button type="button" role="menuitem" x-show="menu.kind === 'file' || selectedFiles().length" @click="copyItem()">Copy</button>
      <button
        type="button"
        role="menuitem"
        x-show="menu.kind === 'file' || selectedFiles().length"
        @click="setVisibility('public')"
      >Make public</button>
      <button
        type="button"
        role="menuitem"
        x-show="menu.kind === 'file' || selectedFiles().length"
        @click="setVisibility('private')"
      >Make private</button>
      <button type="button" role="menuitem" :disabled="!clipboard" @click="pasteHere()">Paste</button>
      <button
        type="button"
        role="menuitem"
        x-show="!menu.kind"
        @click="promptNewFolder(folderId); closeMenu()"
      >New folder</button>
      <button type="button" role="menuitem" x-show="menu.kind || selection.length" @click="renameItem()">Rename</button>
      <button type="button" role="menuitem" class="is-danger" x-show="menu.kind || selection.length" @click="deleteItem()">Delete</button>
    </div>
  </template>
</div>

@include('shamar::partials/shell-close')
