@include('shamar::partials/shell-open')

@let(gridClass = dashboardColumns === 1
  ? 'shamar-dashboard-grid grid gap-4 grid-cols-1'
  : dashboardColumns === 2
    ? 'shamar-dashboard-grid grid gap-4 sm:grid-cols-2'
    : dashboardColumns === 4
      ? 'shamar-dashboard-grid grid gap-4 sm:grid-cols-2 xl:grid-cols-4'
      : 'shamar-dashboard-grid grid gap-4 sm:grid-cols-2 xl:grid-cols-3')

<div class="{{ gridClass }}">
  @each(widget in dashboardWidgets)
    @include('shamar::widgets/shell')
  @else
    <div class="shamar-card rounded-xl p-6 sm:col-span-2 xl:col-span-3">
      <p class="text-sm text-body-subtle">No dashboard widgets configured.</p>
    </div>
  @endeach
</div>

@include('shamar::partials/shell-close')
