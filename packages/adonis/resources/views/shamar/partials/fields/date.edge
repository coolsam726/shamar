@let(stateRef = fieldStateRef(field.name, bindRoot))
@let(nestedField = !!(typeof bindRoot === 'string' && bindRoot))
@let(useNative = !!(field.widget && field.widget.native))
@let(seconds = !!(field.widget && field.widget.seconds) || field.step === 1 || field.step === '1')
@let(timeFormat = (field.widget && field.widget.timeFormat) || '')
@let(minuteStep = (field.widget && field.widget.minuteStep) != null ? field.widget.minuteStep : '')
@let(inputType = formInputType(field))
@let(fieldLabel = field.label ?? humanizeLabel(field.name))
@if(useNative)
  <input
    id="field-{{ field.name }}"
    type="{{ inputType }}"
    @if(!nestedField)
      name="{{ field.name }}"
    @endif
    {{ field.required ? 'required' : '' }}
    {{ field.readonly ? 'readonly' : '' }}
    {{{ fieldInputAttrs(field) }}}
    @if(seconds && (field.type === 'datetime' || field.type === 'time') && !field.step)
      step="1"
    @endif
    x-model="{{ stateRef }}"
    @input="onFieldInput('{{ field.name }}')"
    @change="onFieldChange('{{ field.name }}')"
    @blur="onFieldBlur('{{ field.name }}')"
    :disabled="isDisabled('{{ field.name }}')"
    :placeholder='fieldMeta[{{ jsonAttr(field.name) }}]?.placeholder || {{ jsonAttr(field.placeholder ?? "") }}'
    class="shamar-input shamar-input--{{ field.type }}{{ formErrors && formErrors[field.name] ? ' is-invalid' : '' }}"
  />
@else
  <div
    class="shamar-flowbite-picker shamar-flowbite-picker--{{ field.type }}{{ formErrors && formErrors[field.name] ? ' is-invalid' : '' }}"
    :class="{ 'is-disabled': disabled }"
    x-data="shamarFlowbitePicker({
      name: {{ jsonAttr(field.name) }},
      mode: {{ jsonAttr(field.type) }},
      seconds: {{ seconds ? 'true' : 'false' }},
      timeFormat: {{ jsonAttr(timeFormat) }},
      minuteStep: {{ minuteStep === '' ? 'null' : Number(minuteStep) }},
      min: {{ jsonAttr(field.minValue != null ? String(field.minValue) : '') }},
      max: {{ jsonAttr(field.maxValue != null ? String(field.maxValue) : '') }},
      placeholder: {{ jsonAttr(field.placeholder ?? '') }},
      getValue: () => {{ stateRef }},
      setValue: (v) => { {{ stateRef }} = v; onFieldChange({{ jsonAttr(field.name) }}); },
      isDisabled: () => isDisabled({{ jsonAttr(field.name) }}),
    })"
    @keydown.escape.window="onEscape()"
  >
    <div class="shamar-flowbite-picker__row">
      @if(field.type !== 'time')
        <div class="relative flex-1 min-w-0" x-ref="pickerHost">
          <div class="shamar-flowbite-picker__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
              <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
            </svg>
          </div>
          <input
            id="field-{{ field.name }}"
            x-ref="dateInput"
            type="text"
            autocomplete="off"
            class="shamar-input shamar-flowbite-picker__input ps-10"
            :placeholder="placeholder || defaultPlaceholder"
            :disabled="disabled"
            :aria-label="{{ jsonAttr(fieldLabel) }}"
          />
        </div>
      @endif

      @if(field.type === 'datetime' || field.type === 'time')
        <div class="relative shamar-flowbite-picker__time-wrap" x-ref="timeWrap">
          <div class="shamar-flowbite-picker__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="shamar-timepicker__control">
            <input
              @if(field.type === 'time')
                id="field-{{ field.name }}"
              @endif
              type="text"
              :inputmode="timeFormat === '12' ? 'text' : 'numeric'"
              autocomplete="off"
              spellcheck="false"
              class="shamar-input shamar-flowbite-picker__time shamar-timepicker__input ps-10"
              :placeholder="timePlaceholder"
              :disabled="disabled"
              :aria-label="{{ jsonAttr(fieldLabel + ' time') }}"
              :value="timeDraft"
              @focus="onTimeFocus()"
              @keydown="onTimeKeydown($event)"
              @paste="onTimePaste($event)"
              @blur="commitTimeDraft()"
              @click="openTimeAssist()"
            />
            <button
              type="button"
              class="shamar-timepicker__toggle"
              @click="toggleTime()"
              :disabled="disabled"
              :aria-expanded="timeOpen ? 'true' : 'false'"
              aria-label="Adjust time"
              tabindex="-1"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>

          <div
            class="shamar-timepicker"
            x-show="timeOpen"
            x-cloak
            x-transition.opacity.duration.120ms
            role="dialog"
            aria-label="Adjust time"
          >
            <div class="shamar-timepicker__steppers" :class="{ 'has-seconds': seconds, 'has-meridiem': timeFormat === '12' }">
              <div class="shamar-timepicker__stepper">
                <button type="button" class="shamar-timepicker__spin" @click="nudge('hour', 1)" aria-label="Increase hour">+</button>
                <div class="shamar-timepicker__digit" x-text="displayHour"></div>
                <button type="button" class="shamar-timepicker__spin" @click="nudge('hour', -1)" aria-label="Decrease hour">−</button>
                <span class="shamar-timepicker__unit">Hr</span>
              </div>
              <div class="shamar-timepicker__sep" aria-hidden="true">:</div>
              <div class="shamar-timepicker__stepper">
                <button type="button" class="shamar-timepicker__spin" @click="nudge('minute', 1)" aria-label="Increase minute">+</button>
                <div class="shamar-timepicker__digit" x-text="padTime(minute)"></div>
                <button type="button" class="shamar-timepicker__spin" @click="nudge('minute', -1)" aria-label="Decrease minute">−</button>
                <span class="shamar-timepicker__unit">Min</span>
              </div>
              <template x-if="seconds">
                <div class="shamar-timepicker__seconds">
                  <div class="shamar-timepicker__sep" aria-hidden="true">:</div>
                  <div class="shamar-timepicker__stepper">
                    <button type="button" class="shamar-timepicker__spin" @click="nudge('second', 1)" aria-label="Increase second">+</button>
                    <div class="shamar-timepicker__digit" x-text="padTime(second)"></div>
                    <button type="button" class="shamar-timepicker__spin" @click="nudge('second', -1)" aria-label="Decrease second">−</button>
                    <span class="shamar-timepicker__unit">Sec</span>
                  </div>
                </div>
              </template>
              <template x-if="timeFormat === '12'">
                <div class="shamar-timepicker__stepper shamar-timepicker__meridiem">
                  <button type="button" class="shamar-timepicker__spin" @click="nudge('meridiem', 1)" aria-label="Toggle AM/PM">+</button>
                  <div class="shamar-timepicker__digit" x-text="meridiem"></div>
                  <button type="button" class="shamar-timepicker__spin" @click="nudge('meridiem', 1)" aria-label="Toggle AM/PM">−</button>
                  <span class="shamar-timepicker__unit"> </span>
                </div>
              </template>
            </div>
            <div class="shamar-timepicker__chips">
              <button type="button" class="shamar-timepicker__chip" @click="setTimeNow()">Now</button>
              <button type="button" class="shamar-timepicker__chip" @click="clearTime()">Clear</button>
            </div>
          </div>
        </div>
      @endif
    </div>

    @if(!nestedField)
      <input type="hidden" name="{{ field.name }}" :value="stateValue" />
    @endif
  </div>
@endif
