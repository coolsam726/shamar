<aside
  class="shamar-sidebar fixed md:relative inset-y-0 left-0 z-30 w-64 h-dvh md:h-full bg-shamar-shell flex flex-col flex-shrink-0 md:translate-x-0 transition-transform duration-200 ease-in-out{{ sidebarOffcanvas ? ' shamar-sidebar--offcanvas' : '' }}{{ navigationType === 'inverse' ? ' shamar-sidebar--inverse' : '' }}{{ navigationType === 'side' ? ' shamar-sidebar--side' : '' }}"
  :class="{ '-translate-x-full': !sidebarOpen }"
  data-shamar-nav-type="{{ navigationType }}"
>
  @if(sidebarOffcanvas)
    <div class="shamar-sidebar-offcanvas" hidden></div>
  @endif

  <div class="shamar-brand-panel relative px-4 shrink-0 flex items-center min-h-[60px] bg-neutral-primary border-b border-card-border">
    <a href="{{ basePath || '/' }}" class="flex min-w-0 items-center gap-2.5 text-inherit no-underline">
      @if(branding.showLogo && branding.logoUrl)
        <img
          src="{{ branding.logoUrl }}"
          alt="{{ branding.brandName }}"
          class="shamar-brand-logo shamar-brand-logo--light w-auto max-w-[9rem] object-contain"
          style="height: var(--shamar-logo-height, {{ branding.logoHeight }})"
        />
        <img
          src="{{ branding.logoDarkUrl ?? branding.logoUrl }}"
          alt="{{ branding.brandName }}"
          class="shamar-brand-logo shamar-brand-logo--dark w-auto max-w-[9rem] object-contain"
          style="height: var(--shamar-logo-height, {{ branding.logoHeight }})"
        />
      @endif
      @if(branding.showBrandName)
        <span class="shamar-brand-name truncate text-base font-extrabold tracking-tight">{{ panelTitle }}</span>
      @endif
    </a>
    <button
      type="button"
      @click="sidebarOpen = false"
      aria-label="Close sidebar"
      class="absolute right-3 top-1/2 -translate-y-1/2 md:hidden p-1.5 rounded-md text-body hover:bg-surface-hover hover:text-heading"
    >
      {{{ iconSvg('x-mark', 'w-4 h-4') }}}
    </button>
  </div>

  {{-- APP: L1 roots only. INVERSE: active group's children. SIDE: full accordion/static tree. TOP: empty on desktop. --}}
  @if(navigationType === 'app')
    <nav
      class="shamar-sidebar__roots flex-1 px-2 py-3 space-y-0.5 overflow-y-auto"
      aria-label="Applications"
      data-wire-sync="sidebar-roots"
    >
      @each(root in menuRoots)
        <a
          href="{{ root.href }}"
          wire:navigate
          class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-md text-sm {{ root.active ? 'nav-active' : '' }}"
          @click="sidebarOpen = false"
        >
          <span class="shrink-0 w-4 h-4">
            @include('shamar::partials/icon')
          </span>
          <span class="truncate">{{ root.label }}</span>
        </a>
      @endeach
    </nav>
  @elseif(navigationType === 'inverse')
    <nav
      class="shamar-sidebar__roots flex-1 px-2 py-3 space-y-0.5 overflow-y-auto"
      aria-label="{{ menuActiveRoot ? `${menuActiveRoot.label} menu` : 'Navigation' }}"
      data-wire-sync="sidebar-roots"
    >
      @each(item in menuSecondary)
        @if(item.children && item.children.length)
          <p class="px-3 pt-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-body-subtle">{{ item.label }}</p>
          @each(child in item.children)
            <a
              href="{{ child.href }}"
              wire:navigate
              class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-md text-sm {{ child.active ? 'nav-active' : '' }}"
              @click="sidebarOpen = false"
            >
              @if(child.icon)
                @let(item = child)
                <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
              @endif
              <span class="truncate">{{ child.label }}</span>
            </a>
          @endeach
        @else
          <a
            href="{{ item.href }}"
            wire:navigate
            class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-md text-sm {{ item.active ? 'nav-active' : '' }}"
            @click="sidebarOpen = false"
          >
            @if(item.icon)
              <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
            @endif
            <span class="truncate">{{ item.label }}</span>
          </a>
        @endif
      @endeach
    </nav>
  @elseif(navigationType === 'side')
    <nav
      class="shamar-sidebar__roots shamar-sidebar__side flex-1 px-2 py-3 overflow-y-auto"
      aria-label="Navigation"
      data-wire-sync="sidebar-roots"
      @if(sideNavMode === 'accordion')
        data-shamar-nav-accordion
      @endif
    >
      @each(root in menuRoots)
        @if(root.children && root.children.length)
          @if(sideNavMode === 'accordion')
            <details class="shamar-nav-group-collapsible" {{ root.active ? 'open' : '' }}>
              <summary class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-md text-sm cursor-pointer list-none {{ root.active ? 'nav-active' : '' }}">
                <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
                <span class="truncate flex-1">{{ root.label }}</span>
                {{{ iconSvg('chevron-down', 'w-3 h-3 text-body-subtle shamar-nav-chevron') }}}
              </summary>
              <div class="shamar-nav-tree pl-3 ml-3 border-l border-card-border space-y-0.5 pb-2">
                @each(item in root.children)
                  @if(item.children && item.children.length)
                    <p class="px-3 pt-1 text-[11px] font-semibold uppercase tracking-wider text-body-subtle">{{ item.label }}</p>
                    @each(child in item.children)
                      <a href="{{ child.href }}" wire:navigate class="nav-item flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm {{ child.active ? 'nav-active' : '' }}" @click="sidebarOpen = false">
                        <span class="truncate">{{ child.label }}</span>
                      </a>
                    @endeach
                  @else
                    <a href="{{ item.href }}" wire:navigate class="nav-item flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm {{ item.active ? 'nav-active' : '' }}" @click="sidebarOpen = false">
                      @if(item.icon)
                        <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
                      @endif
                      <span class="truncate">{{ item.label }}</span>
                    </a>
                  @endif
                @endeach
              </div>
            </details>
          @else
            <div class="mb-2">
              <p class="px-3 mb-1 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-body-subtle">
                <span class="shrink-0 w-3.5 h-3.5">@include('shamar::partials/icon')</span>
                {{ root.label }}
              </p>
              <div class="shamar-nav-tree pl-3 ml-3 border-l border-card-border space-y-0.5 {{ root.active ? 'shamar-nav-tree--active' : '' }}">
                @each(item in root.children)
                  @if(item.children && item.children.length)
                    <p class="px-3 pt-1 text-[11px] font-semibold uppercase tracking-wider text-body-subtle">{{ item.label }}</p>
                    @each(child in item.children)
                      <a href="{{ child.href }}" wire:navigate class="nav-item flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm {{ child.active ? 'nav-active' : '' }}" @click="sidebarOpen = false">
                        <span class="truncate">{{ child.label }}</span>
                      </a>
                    @endeach
                  @else
                    <a href="{{ item.href }}" wire:navigate class="nav-item flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm {{ item.active ? 'nav-active' : '' }}" @click="sidebarOpen = false">
                      @if(item.icon)
                        <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
                      @endif
                      <span class="truncate">{{ item.label }}</span>
                    </a>
                  @endif
                @endeach
              </div>
            </div>
          @endif
        @else
          <a
            href="{{ root.href }}"
            wire:navigate
            class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-md text-sm {{ root.active ? 'nav-active' : '' }}"
            @click="sidebarOpen = false"
          >
            <span class="shrink-0 w-4 h-4">@include('shamar::partials/icon')</span>
            <span class="truncate">{{ root.label }}</span>
          </a>
        @endif
      @endeach
    </nav>
  @endif

  <div class="shamar-sidebar__mobile flex-1 min-h-0 flex flex-col overflow-hidden">
    @include('shamar::partials/nav-mobile')
  </div>

  <div class="shamar-sidebar__user px-4 py-3 text-xs text-body-subtle border-t border-card-border/80">
    @if(branding.copyrightText)
      <p class="mb-2 leading-relaxed">{{ branding.copyrightText }}</p>
    @endif
    <p class="truncate">
      Signed in as <span class="font-semibold text-heading">{{ user.name }}</span>
      @if(masquerade && masquerade.active)
        <span class="ml-1 inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide bg-warning-soft text-warning-strong">Masquerade</span>
      @endif
    </p>
  </div>
</aside>
