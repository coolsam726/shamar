<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ pageTitle }} · {{ panelTitle }}</title>
  @if(branding.fontPreconnect || (themeHead && themeHead.fontPreconnect))
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  @endif
  @if(themeHead && themeHead.runtimeHeadHtml)
    {{{ themeHead.runtimeHeadHtml }}}
  @endif
  @if(branding.fontUrl)
    <link rel="stylesheet" href="{{ branding.fontUrl }}" />
  @endif
  @if(themeHead && themeHead.fontUrl)
    <link rel="stylesheet" href="{{ themeHead.fontUrl }}" />
  @endif
  {{-- Fonts: branding.fontUrl + theme.googleFonts() --}}
  <link rel="stylesheet" href="{{ basePath }}/assets/admin.css" />
  <link rel="stylesheet" href="{{ basePath }}/assets/branding.css" />
  @if(themeHead && themeHead.stylesheetHref)
    <link rel="stylesheet" href="{{ themeHead.stylesheetHref }}" />
  @endif
  <style>:root { --shamar-logo-height: {{ branding.logoHeight }}; }</style>
  <meta name="csrf-token" content="{{ csrfToken }}" />
  <script>
    (function () {
      const stored = localStorage.getItem('shamar-theme') || 'system';
      const dark =
        stored === 'dark' ||
        (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.classList.add('dark');
    })();
  </script>
  <script defer src="{{ basePath }}/assets/shamar-ui.js"></script>
  <script defer src="{{ basePath }}/assets/wire.js"></script>
  <script defer src="{{ basePath }}/assets/alpine.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body
  class="shamar-panel h-dvh overflow-hidden bg-shamar-shell text-body antialiased flex md:flex-row{{ themeChrome && themeChrome.panel ? ` ${themeChrome.panel}` : '' }}"
  data-shamar-theme="{{ themeId || 'shamar' }}"
  x-data="shamarShell()"
  data-shamar-base-path="{{ basePath }}"
  data-shamar-sidebar-offcanvas="{{ sidebarOffcanvas ? 'true' : 'false' }}"
>
  <div
    x-show="sidebarOpen"
    x-cloak
    x-transition.opacity
    class="fixed inset-0 z-20 bg-black/30 md:hidden"
    @click="sidebarOpen = false"
  ></div>

  @if(themePartials && themePartials.sidebar)
    {{{ themePartials.sidebar }}}
  @else
    @include('shamar::partials/nav')
  @endif

  <div class="flex min-w-0 flex-1 flex-col h-full min-h-0 overflow-hidden">
    @if(themePartials && themePartials.topbar)
      {{{ themePartials.topbar }}}
    @else
      @include('shamar::partials/topbar')
    @endif

    @if(masquerade && masquerade.active)
      <div
        data-shamar-masquerade-banner
        class="shamar-masquerade-banner shrink-0 z-20"
        role="status"
      >
        <div class="shamar-masquerade-banner__clip">
          <div
            class="shamar-masquerade-banner__body px-4 md:px-6 py-2.5 text-sm bg-warning-soft text-warning-strong border-b border-toast-warning-border"
          >
            <span class="font-semibold">Masquerade</span>
            — signed in as {{ user.name }}
            @if(user.email)
              ({{ user.email }})
            @endif
            . Not a real credential login.
          </div>
        </div>
      </div>
    @endif

    <div
      data-shamar-scroll-root
      class="shamar-scroll-root flex-1 min-h-0 overflow-x-hidden overflow-y-auto px-3 md:px-4{{ themeChrome && themeChrome.scroll ? ` ${themeChrome.scroll}` : '' }}{{ themeChrome && themeChrome.content ? ` ${themeChrome.content}` : '' }}"
    >

      @include('shamar::partials/toast')

      @if(menuActiveRoot && menuActiveRoot.label !== 'Dashboard')
        <div
          class="shamar-mobile-group md:hidden"
          data-wire-sync="mobile-group"
        >
          <span class="shamar-mobile-group__label">{{ menuActiveRoot.label }}</span>
        </div>
      @endif

      @if(pageTitle)
        @include('shamar::partials/page-heading')
      @endif

      <main
        class="mx-auto {{ contentMaxWidthClass || 'w-full max-w-screen-xl' }}"
        style="{{ contentMaxWidthStyle || 'max-width: 80rem' }}"
      >
