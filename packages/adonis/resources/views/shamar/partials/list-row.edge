<tr
  class="shamar-list-row hover:bg-surface-row-hover transition-colors cursor-pointer"
  data-shamar-record-id="{{ record.id }}"
  data-shamar-row-href="{{ basePath }}/{{ resource.slug }}/{{ record.id }}{{ recordNavQuery(query) }}"
>
  <td class="px-3 py-3" data-shamar-stop-row-nav>
    @if(bulkActions && bulkActions.length)
      <input
        type="checkbox"
        class="rounded border-default"
        :checked="selected.includes({{ jsonAttr(String(record.id)) }})"
        @change="toggleId({{ jsonAttr(String(record.id)) }})"
        aria-label="Select record"
      />
    @endif
  </td>
  @each(column in resource.columns)
    <td class="px-4 py-3 text-body {{ resolveAlignmentClass(column) }}">
      @if(column.type === 'boolean' || column.format === 'boolean' || column.format === 'toggle')
        @!component('shamar::partials/boolean-value', {
          checked: !!record[column.name],
          label: cellValue(record, column),
        })
      @elseif(column.format === 'badge' || column.type === 'tags')
        @let(badges = badgeValues(record, column))
        @if(badges.length)
          <div class="shamar-badges">
            @each(badge in badges)
              <span class="shamar-badge">{{ badge }}</span>
            @endeach
          </div>
        @else
          —
        @endif
      @else
        @let(relatedHref = relatedListLink(resource, record, column, basePath))
        @if(relatedHref)
          <a
            href="{{ relatedHref }}"
            data-shamar-stop-row-nav
            class="text-fg-brand hover:underline"
          >{{ cellValue(record, column) }}</a>
        @else
          <span class="text-heading">{{ cellValue(record, column) }}</span>
        @endif
      @endif
    </td>
  @endeach
  <td class="px-4 py-3 text-right shamar-list-row__actions" data-shamar-stop-row-nav>
    @if(rowActions && rowActions.length)
      @let(rowActionParts = partitionRowActions(rowActions))
      <div class="shamar-row-actions">
        @each(action in rowActionParts.inline)
          @!component('shamar::partials/list-row-action', {
            action: action,
            menuItem: false,
            record: record,
            resource: resource,
            basePath: basePath,
            query: query,
            showEditButton: showEditButton,
            showDeleteButton: showDeleteButton,
          })
        @endeach

        @if(rowActionParts.menu.length)
          <div
            class="shamar-row-actions__menu"
            x-data="shamarFloatingMenu()"
            @keydown.escape.window="close()"
            @click.outside="close()"
          >
            <button
              type="button"
              class="shamar-row-actions__trigger"
              x-ref="trigger"
              :aria-expanded="open.toString()"
              aria-haspopup="menu"
              aria-label="Row actions"
              @click="toggle()"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 6a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm0 5.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm0 5.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/>
              </svg>
            </button>
            <div
              x-show="open"
              x-cloak
              x-ref="panel"
              x-bind:style="panelStyle"
              x-transition.opacity.duration.120ms
              class="shamar-row-actions__panel"
              role="menu"
              aria-label="Row actions"
            >
              @each(action in rowActionParts.menu)
                @!component('shamar::partials/list-row-action', {
                  action: action,
                  menuItem: true,
                  record: record,
                  resource: resource,
                  basePath: basePath,
                  query: query,
                  showEditButton: showEditButton,
                  showDeleteButton: showDeleteButton,
                })
              @endeach
            </div>
          </div>
        @endif
      </div>
    @endif
  </td>
</tr>
