<section
  class="space-y-4"
  x-data="shamarListSelection()"
  data-shamar-list-root="{{ section.key }}"
  data-shamar-base-path="{{ basePath }}"
  data-shamar-current-view="table"
  data-shamar-total="{{ section.result.total }}"
  data-shamar-search="{{ section.query.search ?? '' }}"
  data-shamar-sort="{{ section.query.sort ?? '' }}"
  data-shamar-direction="{{ section.query.direction ?? '' }}"
>
  <div class="shamar-card shamar-list-card rounded-xl">
    {{-- Edge 6 uses @let (not legacy @set) so locals reach @include'd partials --}}
    @let(query = section.query)
    @let(resource = section.resource)
    @let(listHeaders = section.listHeaders)
    @let(filtersLockedEmpty = section.filtersLockedEmpty)
    @let(groupLockedEmpty = section.groupLockedEmpty)
    @let(listAllPerPage = section.listAllPerPage)
    @let(defaultPerPage = section.defaultPerPage)
    @let(perPageOptions = section.perPageOptions)
    @let(queryPrefix = section.queryPrefix)
    @include('shamar::partials/list-toolbar')

    <div class="shamar-list-table-scroll">
      <table class="w-full text-sm">
        <thead class="bg-neutral-primary border-b border-card-border">
          <tr>
            <th class="w-9 px-3 py-3"></th>
            @each(column in section.resource.columns)
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-body-subtle whitespace-nowrap {{ resolveAlignmentClass(column) }}">
                @if(column.sortable !== false)
                  @let(sortState = section.query.sort === column.name ? (section.query.direction === 'desc' ? 'desc' : 'asc') : 'idle')
                  <a
                    href="{{ pageSectionSortColumnUrl(basePath, page.slug, section.key, section.query, column.name, { preserveQuery: preserveQuery }) }}"
                    class="inline-flex items-center gap-1.5 hover:text-heading transition-colors {{ column.alignment === 'end' || column.alignment === 'right' ? 'justify-end w-full' : (column.alignment === 'center' ? 'justify-center w-full' : '') }}"
                  >
                    {{ column.label ?? humanizeLabel(column.name) }}
                    @include('shamar::partials/sort-indicator')
                  </a>
                @else
                  {{ column.label ?? humanizeLabel(column.name) }}
                @endif
              </th>
            @endeach
          </tr>
        </thead>
        <tbody>
          @if(section.groups && section.groups.length)
            @each(group in section.groups)
              <tr class="shamar-list-group">
                <td colspan="100" class="shamar-list-group__cell">
                  <span class="shamar-list-group__label">{{ group.label }}</span>
                  <span class="shamar-list-group__count">{{ group.items.length }}</span>
                </td>
              </tr>
              @each(record in group.items)
                @let(rowActions = [])
                @include('shamar::partials/list-row')
              @endeach
            @endeach
          @elseif(section.result.items && section.result.items.length)
            @each(record in section.result.items)
              @let(rowActions = [])
              @include('shamar::partials/list-row')
            @endeach
          @else
            <tr>
              <td colspan="100" class="px-4 py-12 text-center text-body-subtle">No records found.</td>
            </tr>
          @endif
        </tbody>
      </table>
    </div>

    @if(section.pagination)
      @let(pagination = section.pagination)
      <div class="shamar-list-pagination" data-shamar-list-pagination>
        @include('shamar::partials/page-section-pagination')
      </div>
    @else
      <div data-shamar-list-pagination hidden></div>
    @endif
  </div>
</section>
