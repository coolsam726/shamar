<header class="shamar-topbar flex items-center gap-3 px-4 md:px-6 min-h-[60px] shrink-0 sticky top-0 z-30 overflow-visible bg-neutral-primary border-b border-card-border">
  <button
    type="button"
    @click="sidebarOpen = true"
    aria-label="Open menu"
    class="md:hidden p-1.5 -ml-1.5 rounded-md text-body hover:bg-surface-hover"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>

  <a
    href="{{ basePath || '/' }}"
    wire:navigate
    class="shamar-topbar__brand md:hidden flex min-w-0 items-center gap-2 text-inherit no-underline"
    aria-label="{{ panelTitle }}"
  >
    @if(branding.showLogo && branding.logoUrl)
      <img
        src="{{ branding.logoUrl }}"
        alt=""
        class="shamar-brand-logo shamar-brand-logo--light w-auto max-w-[7.5rem] object-contain"
        style="height: calc(var(--shamar-logo-height, {{ branding.logoHeight }}) * 0.85)"
      />
      <img
        src="{{ branding.logoDarkUrl ?? branding.logoUrl }}"
        alt=""
        class="shamar-brand-logo shamar-brand-logo--dark w-auto max-w-[7.5rem] object-contain"
        style="height: calc(var(--shamar-logo-height, {{ branding.logoHeight }}) * 0.85)"
      />
    @elseif(branding.showBrandName)
      <span class="truncate text-sm font-extrabold tracking-tight text-heading">{{ panelTitle }}</span>
    @endif
  </a>

  <div class="shamar-topbar__menu flex-1 min-w-0 overflow-hidden" data-wire-sync="topbar-menu">
    <nav
      class="shamar-app-menu flex-1 min-w-0"
      aria-label="{{ menuActiveRoot ? `${menuActiveRoot.label} menu` : 'App menu' }}"
    >
      @if(menuActiveRoot && menuActiveRoot.label !== 'Dashboard')
        @if(!menuSecondary.length)
          <span class="shrink-0 text-sm font-semibold text-heading truncate max-w-[12rem]">{{ menuActiveRoot.label }}</span>
        @endif
      @endif

      @each(item in menuSecondary)
        @if(item.children && item.children.length)
          <div
            class="relative shrink-0"
            x-data="shamarFloatingMenu()"
            @click.outside="close()"
            @keydown.escape.window="close()"
          >
            <button
              type="button"
              x-ref="trigger"
              @click="toggle()"
              class="shamar-topbar-link flex items-center gap-1 px-2.5 py-1.5 rounded-md text-sm whitespace-nowrap {{ item.active ? 'is-active' : '' }}"
              :aria-expanded="open.toString()"
            >
              {{ item.label }}
              <svg class="w-3 h-3 text-body-subtle transition-transform" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
              </svg>
            </button>
            <div
              x-show="open"
              x-cloak
              x-ref="panel"
              x-bind:style="panelStyle"
              class="min-w-[10rem] shamar-card rounded-xl shadow-lg py-1"
            >
              @each(child in item.children)
                <a href="{{ child.href }}" wire:navigate class="shamar-topbar-menu-item block px-3 py-1.5 text-sm whitespace-nowrap {{ child.active ? 'is-active' : '' }}">{{ child.label }}</a>
              @endeach
            </div>
          </div>
        @else
          <a href="{{ item.href }}" wire:navigate class="shamar-topbar-link shrink-0 px-2.5 py-1.5 rounded-md text-sm whitespace-nowrap {{ item.active ? 'is-active' : '' }}">{{ item.label }}</a>
        @endif
      @endeach
    </nav>
  </div>

  <div class="flex-1 min-w-0 md:hidden" aria-hidden="true"></div>

  <div class="shamar-topbar__tools flex items-center gap-1.5 sm:gap-2 min-w-0">
    {{{ globalSearchHtml }}}
    <div data-wire-sync="topbar-notifications" class="contents">
      {{{ notificationsHtml }}}
    </div>
    <button
      type="button"
      @click="cycleTheme()"
      class="shamar-theme-trigger p-1.5 rounded-md text-body hover:bg-surface-hover hover:text-heading"
      :data-theme-pref="themePref"
      :aria-label="themePref === 'system' ? 'Theme: System — click for Light' : themePref === 'dark' ? 'Theme: Dark — click for System' : 'Theme: Light — click for Dark'"
      title="Cycle theme"
    >
      <svg class="w-4 h-4 shamar-theme-icon shamar-theme-icon--light" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
      <svg class="w-4 h-4 shamar-theme-icon shamar-theme-icon--dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
      <svg class="w-4 h-4 shamar-theme-icon shamar-theme-icon--system" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25H5.25A2.25 2.25 0 013 15V6.75A2.25 2.25 0 015.25 4.5h13.5A2.25 2.25 0 0121 6.75V15a2.25 2.25 0 01-2.25 2.25H15M9 17.25v1.5c0 .621.504 1.125 1.125 1.125h3.75c.621 0 1.125-.504 1.125-1.125v-1.5M9 17.25h6"/>
      </svg>
    </button>

    <div class="relative" x-data="{ open: false }" @click.outside="open = false">
      <button
        type="button"
        @click="open = !open"
        aria-haspopup="true"
        :aria-expanded="open.toString()"
        class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-md hover:bg-surface-hover"
      >
        <span class="w-7 h-7 rounded-full bg-fg-brand text-white text-xs font-semibold flex items-center justify-center shrink-0">{{ userInitial }}</span>
        <span class="hidden sm:inline text-sm font-medium text-body max-w-[120px] truncate">{{ user.name }}</span>
        <svg class="w-3 h-3 text-body-subtle hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </button>
      <div x-show="open" x-cloak x-transition class="absolute right-0 top-full mt-2 w-56 shamar-card rounded-xl shadow-lg overflow-hidden z-50">
        <div class="px-4 py-3 border-b border-default">
          <p class="text-sm font-semibold text-heading truncate">{{ user.name }}</p>
          @if(user.email)
            <p class="text-xs text-body-subtle">{{ user.email }}</p>
          @endif
          @if(masquerade && masquerade.active)
            <p class="mt-1.5 text-[10px] font-semibold uppercase tracking-wide text-warning-strong">Masquerade session</p>
          @endif
        </div>
        <div class="py-1 text-sm">
          @if(profilePath)
            <a href="{{ profilePath }}" class="block px-4 py-1.5 text-body hover:bg-surface-hover hover:text-heading">Profile</a>
          @endif
          <a href="{{ basePath }}" class="block px-4 py-1.5 text-body hover:bg-surface-hover hover:text-heading">Dashboard</a>
          @if(userMenuLinks && userMenuLinks.length)
            <div class="my-1 border-t border-default"></div>
            @each(link in userMenuLinks)
              @if(link.external)
                <a
                  href="{{ link.href }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-4 py-1.5 text-body hover:bg-surface-hover hover:text-heading"
                >{{ link.label }}</a>
              @else
                <a href="{{ link.href }}" class="block px-4 py-1.5 text-body hover:bg-surface-hover hover:text-heading">{{ link.label }}</a>
              @endif
            @endeach
          @endif
          @if(logoutPath)
            <form method="post" action="{{ logoutPath }}" class="block">
              @include('shamar::partials/csrf')
              <button type="submit" class="w-full text-left px-4 py-1.5 text-body hover:bg-surface-hover hover:text-heading">
                Sign out
              </button>
            </form>
          @endif
        </div>
      </div>
    </div>
  </div>
</header>
