{{--
  Blade-icons style: short slugs (`home`) or full ids (`heroicon-o-home`, `heroicon-s-home`).
  Expects either `root.icon` (sidebar group) or `item.icon` (nav / topbar link).
--}}
@let(iconName = (item && item.icon) ? item.icon : ((root && root.icon) ? root.icon : 'squares-2x2'))
{{{ iconSvg(iconName, 'w-4 h-4') }}}
