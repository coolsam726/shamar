<div class="shamar-infolist space-y-4">
  @each(node in section.detailSchema)
    @!component('shamar::partials/schema-node', {
      node: node,
      schemaMode: 'detail',
      mode: 'show',
      record: section.record,
      formErrors: {},
      relationUi: section.relationUi || {},
      resource: section.resource || resource,
      basePath: basePath,
    })
  @endeach
</div>
