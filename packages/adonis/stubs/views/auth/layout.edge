<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title || branding.brandName || brandName || 'Sign in' }}</title>
  <script>
    (function () {
      var stored = localStorage.getItem('shamar-theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  @if(branding.fontPreconnect)
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  @endif
  @if(branding.fontUrl)
    <link rel="stylesheet" href="{{ branding.fontUrl }}" />
  @endif
  <style>
{{{ brandingCss }}}

    :root {
      --auth-bg: var(--color-shamar-shell, #f8fafc);
      --auth-surface: var(--color-neutral-primary, #ffffff);
      --auth-heading: var(--color-heading, #0f172a);
      --auth-body: var(--color-body, #475569);
      --auth-muted: var(--color-body-subtle, #64748b);
      --auth-ink: var(--color-heading, #0f172a);
      --auth-line: color-mix(in srgb, var(--color-default, #cbd5e1) 55%, transparent);
      --auth-primary: var(--color-fg-brand, var(--color-primary-500, #f1511b));
      --auth-primary-strong: var(--color-fg-brand-strong, var(--color-primary-700, #c94115));
      --auth-primary-soft: var(--color-brand-soft, var(--color-primary-100, #fee9e2));
      --auth-accent: var(--color-shamar-accent, #286291);
      --auth-font: var(--shamar-font-family, ui-sans-serif, system-ui, sans-serif);
    }

    html.dark {
      --auth-bg: var(--color-shamar-shell, #0f1419);
      --auth-surface: var(--color-neutral-primary, #1a222c);
      --auth-heading: var(--color-heading, #f1f5f9);
      --auth-body: var(--color-body, #cbd5e1);
      --auth-muted: var(--color-body-subtle, #94a3b8);
      --auth-ink: var(--color-heading, #f1f5f9);
      --auth-line: color-mix(in srgb, var(--color-default, #64748b) 50%, transparent);
      --auth-primary-soft: color-mix(in srgb, var(--auth-primary) 22%, transparent);
    }

    * { box-sizing: border-box; }

    html, body {
      min-height: 100%;
      margin: 0;
    }

    body {
      font-family: var(--auth-font);
      color: var(--auth-body);
      background: var(--auth-bg);
      -webkit-font-smoothing: antialiased;
    }

    .auth-shell {
      position: relative;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: clamp(1.5rem, 4vw, 3rem);
      overflow: hidden;
    }

    .auth-atmosphere {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(900px 520px at 8% 12%, color-mix(in srgb, var(--auth-primary) 18%, transparent), transparent 58%),
        radial-gradient(780px 480px at 92% 86%, color-mix(in srgb, var(--auth-accent) 16%, transparent), transparent 55%),
        var(--auth-bg);
      animation: auth-drift 18s ease-in-out infinite alternate;
    }

    .auth-frame {
      position: relative;
      z-index: 1;
      width: min(100%, 26rem);
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      animation: auth-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .auth-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      text-align: center;
    }

    .auth-brand__logo {
      display: block;
      height: var(--shamar-logo-height, 2.75rem);
      max-height: none;
      width: auto;
      margin-inline: auto;
      object-fit: contain;
    }

    .auth-brand__logo--dark {
      display: none;
    }

    html.dark .auth-brand__logo--light {
      display: none;
    }

    html.dark .auth-brand__logo--dark {
      display: block;
    }

    .auth-theme-toggle {
      position: absolute;
      top: 1rem;
      right: 1rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.35rem;
      height: 2.35rem;
      padding: 0;
      border: 1px solid var(--auth-line);
      border-radius: 999px;
      background: color-mix(in srgb, var(--auth-surface) 88%, transparent);
      color: var(--auth-heading);
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .auth-theme-toggle:hover {
      border-color: color-mix(in srgb, var(--auth-primary) 45%, var(--auth-line));
      background: var(--auth-surface);
      transform: translateY(-1px);
    }

    .auth-theme-toggle:focus-visible {
      outline: 2px solid var(--auth-primary);
      outline-offset: 2px;
    }

    .auth-theme-toggle svg {
      width: 1.05rem;
      height: 1.05rem;
    }

    .auth-theme-icon--dark {
      display: none;
    }

    html.dark .auth-theme-icon--light {
      display: none;
    }

    html.dark .auth-theme-icon--dark {
      display: block;
    }

    .auth-brand__name {
      margin: 0;
      font-family: var(--auth-font);
      font-size: clamp(2rem, 5vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: var(--auth-heading);
    }

    .auth-brand__tag {
      margin: 0;
      max-width: 22rem;
      color: var(--auth-muted);
      font-size: 1.02rem;
      line-height: 1.45;
      text-align: center;
    }

    .auth-panel {
      padding: 1.35rem 1.35rem 1.4rem;
      border: 1px solid var(--auth-line);
      border-radius: 0.85rem;
      background: color-mix(in srgb, var(--auth-surface) 92%, transparent);
      backdrop-filter: blur(8px);
    }

    .auth-alert {
      margin: 0 0 1.1rem;
      padding: 0.75rem 0.9rem;
      border-left: 3px solid var(--auth-primary);
      background: var(--auth-primary-soft);
      color: var(--auth-primary-strong);
      font-size: 0.92rem;
      border-radius: 0 0.4rem 0.4rem 0;
      animation: auth-rise 0.4s ease both;
    }

    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .auth-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .auth-field label {
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--auth-heading);
    }

    .auth-field input {
      width: 100%;
      border: 1px solid var(--auth-line);
      border-radius: 0.55rem;
      background: var(--auth-surface);
      color: var(--auth-heading);
      font: inherit;
      font-size: 1rem;
      padding: 0.8rem 0.95rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .auth-field input::placeholder {
      color: color-mix(in srgb, var(--auth-muted) 80%, transparent);
    }

    .auth-field input:focus {
      border-color: color-mix(in srgb, var(--auth-primary) 70%, white);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--auth-primary) 22%, transparent);
    }

    .auth-submit {
      margin-top: 0.25rem;
      appearance: none;
      border: 0;
      border-radius: 0.55rem;
      background: var(--auth-primary);
      color: #fff;
      font: inherit;
      font-weight: 600;
      font-size: 1rem;
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition: transform 0.18s ease, filter 0.18s ease, background 0.18s ease;
    }

    .auth-submit:hover {
      background: var(--auth-primary-strong);
      filter: brightness(1.02);
      transform: translateY(-1px);
    }

    .auth-submit:active {
      transform: translateY(0);
    }

    .auth-hint {
      margin: 1rem 0 0;
      color: var(--auth-muted);
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .auth-masquerade {
      margin: 0.75rem 0 0;
      padding: 0.55rem 0.75rem;
      border-radius: 0.5rem;
      border: 1px solid color-mix(in srgb, #b45309 35%, transparent);
      background: color-mix(in srgb, #d97706 12%, transparent);
      color: #92400e;
      font-size: 0.8rem;
      line-height: 1.4;
      text-align: center;
    }

    html.dark .auth-masquerade {
      border-color: color-mix(in srgb, #fbbf24 35%, transparent);
      background: color-mix(in srgb, #d97706 18%, transparent);
      color: #fde68a;
    }

    .auth-footer {
      margin: 0;
      text-align: center;
      color: var(--auth-muted);
      font-size: 0.78rem;
    }

    @keyframes auth-drift {
      from { transform: scale(1) translate3d(0, 0, 0); }
      to { transform: scale(1.04) translate3d(-1%, 0.8%, 0); }
    }

    @keyframes auth-rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
  <div class="auth-shell">
    <button
      type="button"
      class="auth-theme-toggle"
      data-auth-theme-toggle
      aria-label="Toggle dark mode"
    >
      <svg class="auth-theme-icon auth-theme-icon--light" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
      <svg class="auth-theme-icon auth-theme-icon--dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
    </button>
    <div class="auth-atmosphere" aria-hidden="true"></div>
    <div class="auth-frame">
      {{{ await $slots.main() }}}
      @if(branding.copyrightText)
        <p class="auth-footer">{{ branding.copyrightText }}</p>
      @endif
    </div>
  </div>
  <script>
    (function () {
      var btn = document.querySelector('[data-auth-theme-toggle]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var next = document.documentElement.classList.toggle('dark');
        localStorage.setItem('shamar-theme', next ? 'dark' : 'light');
      });
    })();
  </script>
</body>
</html>
