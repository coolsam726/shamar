{{{
  exports({
    to: app.makePath(`app/widgets/${panel}/${fileName}`),
  })
}}}
import {
  StatsOverviewWidget,
  Stat,
  type WidgetRequestContext,
} from '@shamar/core'

export class {{ className }} extends StatsOverviewWidget {
  static override sort = {{ sort }}
  static override columnSpan = 'full' as const
  static override heading = '{{ label }}'
  static override description = 'An overview of key metrics.'
  static override columns = 4
  /** Filament default is lazy + 5s polling; override as needed. */
  static override isLazy = false
  static override pollingInterval: string | null = '5s'

  static override async stats(_ctx: WidgetRequestContext) {
    return [
      Stat.make('Total', 0)
        .description('Replace with a real query')
        .descriptionIcon('arrow-trending-up')
        .color('success')
        .chart([1, 2, 3, 4, 5, 6, 7]),
      Stat.make('Open', 0).color('warning'),
      Stat.make('Done', 0).color('info'),
      Stat.make('Failed', 0).color('danger'),
    ]
  }
}
