@layouts.auth({
  title: (branding.brandName || brandName || 'Admin') + ' · Sign in',
  branding,
  brandingCss,
  brandName: branding.brandName || brandName || 'Admin',
})
  <header class="auth-brand">
    @if(branding.showLogo && branding.logoUrl)
      <img
        class="auth-brand__logo"
        src="{{ branding.logoUrl }}"
        alt="{{ branding.brandName || brandName || 'Admin' }}"
      />
    @endif
    @if(branding.showBrandName)
      <p class="auth-brand__name">{{ branding.brandName || brandName || 'Admin' }}</p>
    @endif
    @if(loginSubtitle)
      <p class="auth-brand__tag">{{ loginSubtitle }}</p>
    @endif
  </header>

  <div class="auth-panel">
    @if(demoSandbox)
      <aside class="auth-demo" role="note" data-demo-sandbox data-next-reset="{{ demoSandbox.nextResetAt }}">
        <p class="auth-demo__title">Shared sandbox</p>
        <p class="auth-demo__body">
          Resets every {{ demoSandbox.intervalMinutes }} minutes.
          Next wipe in
          <strong data-demo-countdown>…</strong>
          (<time datetime="{{ demoSandbox.nextResetAt }}">{{ demoSandbox.nextResetAt }}</time>).
        </p>
        <ul class="auth-demo__accounts">
          @each(account in demoSandbox.accounts)
            <li>
              <strong>{{ account.role }}</strong>
              — {{ account.email }} / <code>{{ account.password }}</code>
            </li>
          @endeach
        </ul>
      </aside>
      <script>
        (function () {
          var root = document.querySelector('[data-demo-sandbox]')
          if (!root) return
          var el = root.querySelector('[data-demo-countdown]')
          var raw = root.getAttribute('data-next-reset')
          if (!el || !raw) return
          var target = Date.parse(raw)
          if (Number.isNaN(target)) return
          function tick() {
            var ms = target - Date.now()
            if (ms <= 0) {
              el.textContent = 'resetting…'
              return
            }
            var total = Math.floor(ms / 1000)
            var m = Math.floor(total / 60)
            var s = total % 60
            el.textContent = m + ':' + String(s).padStart(2, '0')
          }
          tick()
          setInterval(tick, 1000)
        })()
      </script>
    @endif

    @if(flashMessages.has('error'))
      <p class="auth-alert" role="alert">{{ flashMessages.get('error') }}</p>
    @end

    <form method="POST" action="{{ route('session.store') }}" class="auth-form">
      {{ csrfField() }}

      <div class="auth-field">
        <label for="email">{{ loginUsernameLabel }}</label>
        <input
          id="email"
          type="{{ loginMode === 'local' ? 'email' : 'text' }}"
          name="email"
          autocomplete="username"
          required
          autofocus
          placeholder="{{ loginUsernamePlaceholder }}"
        />
      </div>

      <div class="auth-field">
        <label for="password">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="auth-submit">Sign in</button>
    </form>

    @if(loginFooter)
      <p class="auth-hint">{{ loginFooter }}</p>
    @endif

    @if(masqueradeEnabled)
      <p class="auth-masquerade" role="note">Masquerade enabled (non-production).</p>
    @endif
  </div>
@end
