---
import type { DemoStatus } from '../lib/demo';

interface Props {
  /** Override demo origin. Empty / omitted = same origin (unified server). */
  demoUrl?: string;
}

const configured =
  Astro.props.demoUrl !== undefined
    ? Astro.props.demoUrl
    : (import.meta.env.PUBLIC_DEMO_URL as string | undefined);

/** Same-origin by default so one Adonis process can serve docs + panel. */
const demoBase = String(configured ?? '')
  .trim()
  .replace(/\/$/, '');

const siteOrigin = (
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  'http://localhost:3333'
).replace(/\/$/, '');

const statusUrl = demoBase ? `${demoBase}/demo-status` : `${siteOrigin}/demo-status`;
const panelUrl = demoBase ? `${demoBase}/demo` : '/demo';
const loginUrl = demoBase ? `${demoBase}/login` : '/login';

let status: DemoStatus | null = null;
let error: string | null = null;

try {
  const res = await fetch(statusUrl, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) {
    status = (await res.json()) as DemoStatus;
  } else {
    error = `Demo status unavailable (${res.status}).`;
  }
} catch {
  error = 'Demo is offline or unreachable from this build.';
}

const accounts = status?.accounts ?? [
  { email: 'admin@example.com', password: 'password', role: 'admin' },
  { email: 'viewer@example.com', password: 'password', role: 'viewer' },
];
const nextResetAt = status?.nextResetAt ?? null;
const intervalMinutes = Math.round((status?.intervalSeconds ?? 1200) / 60);
---

<section
  class="shamar-demo-card"
  data-shamar-demo-card
  data-demo-base={demoBase}
  data-next-reset={nextResetAt ?? ''}
>
  <h3>Live sandbox</h3>
  <p>
    Shared demo resets every <strong>{intervalMinutes} minutes</strong>. Use these credentials, explore freely,
    expect a wipe on the clock.
  </p>

  <div class="shamar-demo-meta">
    {
      accounts.map((account) => (
        <div>
          <div>
            <strong>{account.role}</strong>
          </div>
          <div>
            <code>{account.email}</code>
          </div>
          <div>
            password <code>{account.password}</code>
          </div>
        </div>
      ))
    }
  </div>

  <div class="shamar-demo-meta">
    <span>
      Next reset:{' '}
      <span class="shamar-countdown" data-shamar-countdown>
        {nextResetAt ? '…' : 'when demo is online'}
      </span>
    </span>
    {error ? <span role="status">{error}</span> : null}
  </div>

  <div class="shamar-demo-actions">
    <a href={loginUrl}>Sign in</a>
    <a class="secondary" href={panelUrl}>
      Open /demo
    </a>
  </div>
</section>

<script>
  function formatRemaining(ms) {
    if (ms <= 0) return 'resetting…';
    const total = Math.floor(ms / 1000);
    const m = Math.floor(total / 60);
    const s = total % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  function bindCountdown(root) {
    const el = root.querySelector('[data-shamar-countdown]');
    if (!el) return;

    let target = Date.parse(root.getAttribute('data-next-reset') || '');
    const demoBase = root.getAttribute('data-demo-base') || '';

    const tick = () => {
      if (Number.isNaN(target)) {
        el.textContent = 'when demo is online';
        return;
      }
      el.textContent = formatRemaining(target - Date.now());
    };

    const refresh = async () => {
      try {
        const res = await fetch(`${demoBase}/demo-status`, { headers: { Accept: 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (data?.nextResetAt) {
          root.setAttribute('data-next-reset', data.nextResetAt);
          target = Date.parse(data.nextResetAt);
          tick();
        }
      } catch {
        /* offline — keep last known countdown */
      }
    };

    tick();
    window.setInterval(tick, 1000);
    window.setInterval(refresh, 30_000);
    void refresh();
  }

  document.querySelectorAll('[data-shamar-demo-card]').forEach(bindCountdown);
</script>
