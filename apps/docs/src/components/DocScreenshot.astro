---
interface Props {
  src: string
  alt: string
  caption?: string
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['doc-shot', { 'doc-shot--wide': wide }]}>
  <button
    type="button"
    class="doc-shot__trigger lightbox-trigger"
    data-lightbox
    data-lightbox-src={src}
    data-lightbox-alt={alt}
    data-lightbox-caption={caption ?? ''}
    aria-label={`Enlarge: ${alt}`}
  >
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    <span class="doc-shot__hint" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path
          d="M14 3h7v7M10 14 21 3M21 14v7h-7M3 10V3h7"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>

<style>
  .doc-shot {
    margin: 1.75rem 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 70%, transparent);
    background: var(--sl-color-gray-6);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--sl-color-black) 6%, transparent),
      0 18px 40px color-mix(in srgb, var(--sl-color-black) 8%, transparent);
  }

  .doc-shot__trigger {
    position: relative;
  }

  .doc-shot__trigger img {
    vertical-align: middle;
    transition: transform 0.35s ease, filter 0.35s ease;
  }

  .doc-shot__trigger:hover img,
  .doc-shot__trigger:focus-visible img {
    transform: scale(1.012);
    filter: brightness(1.02);
  }

  .doc-shot__hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, #0f172a 72%, transparent);
    color: #fff;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .doc-shot__trigger:hover .doc-shot__hint,
  .doc-shot__trigger:focus-visible .doc-shot__hint {
    opacity: 1;
    transform: translateY(0);
  }

  .doc-shot figcaption {
    padding: 0.65rem 1rem 0.85rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
    border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 60%, transparent);
  }

  .doc-shot--wide {
    margin-inline: calc(var(--sl-content-margin-inline, 1rem) * -0.35);
  }

  @media (min-width: 72rem) {
    .doc-shot--wide {
      margin-inline: -2rem;
    }
  }
</style>
