---
/**
 * Shamar lockup for the Starlight header.
 * The theme's SiteTitle always renders Almasix banners from public/, so this slot is local.
 */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const darkSrc = `${base}branding/shamar-banner-dark.svg`;
const lightSrc = `${base}branding/shamar-banner.svg`;
---

<div class="site-title sl-flex">
  <a class="site-title-mark" href={base} aria-label="Shamar">
    <img class="light:sl-hidden print:hidden" alt="Shamar" src={darkSrc} width="180" height="46" />
    <img class="dark:sl-hidden print:block" alt="" src={lightSrc} width="180" height="46" />
  </a>
</div>

<style>
  @layer starlight.core {
    .site-title {
      align-items: flex-end;
      gap: 0;
      min-width: 0;
      white-space: nowrap;
    }
    .site-title-mark {
      display: inline-flex;
      align-items: flex-end;
      text-decoration: none;
      min-width: 0;
      margin: 0;
      padding: 0;
      line-height: 0;
    }
    .site-title-mark img {
      display: block;
      height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
      width: auto;
      max-width: 11rem;
      object-fit: contain;
      object-position: 0 100%;
      margin: 0;
      padding: 0;
    }
  }
</style>
