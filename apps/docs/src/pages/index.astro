---
import SiteNav from '../components/SiteNav.astro';
import DemoCredentials from '../components/DemoCredentials.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Filament-inspired admin panel for AdonisJS — resources, forms, tables, and pages."
    />
    <meta name="theme-color" content="#f1511b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Sora:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Shamar — Admin panels for AdonisJS</title>
  </head>
  <body class="landing">
    <div class="landing__atmosphere" aria-hidden="true"></div>
    <SiteNav />

    <main>
      <section class="landing__hero">
        <div class="landing__copy">
          <p class="landing__brand">
            <img
              src="/branding/shamar-banner.svg"
              width="320"
              height="85"
              alt="Shamar"
            />
          </p>
          <h1>Admin panels that feel intentional.</h1>
          <p class="landing__lede">
            Filament-shaped resources, forms, and tables — native to AdonisJS, Lucid or Mongoose.
          </p>
          <div class="landing__ctas">
            <a class="btn btn--primary" href="/docs/guides/installation/">Read the docs</a>
            <a class="btn btn--ghost" href="/demo">Open live demo</a>
            <a class="btn btn--text" href="/docs/guides/first-resource/">See examples</a>
          </div>
        </div>
        <div class="landing__visual" aria-hidden="true">
          <div class="landing__panel-frame">
            <div class="landing__panel-chrome">
              <span></span><span></span><span></span>
              <img class="landing__panel-mark" src="/branding/shamar-logo.svg" width="28" height="28" alt="" />
            </div>
            <div class="landing__panel-body">
              <div class="landing__sidebar-skel">
                <img src="/branding/shamar-logo.svg" width="36" height="36" alt="" />
                <i></i><i></i><i></i>
              </div>
              <div class="landing__main-skel">
                <div class="landing__row"></div>
                <div class="landing__row landing__row--wide"></div>
                <div class="landing__row"></div>
                <div class="landing__chips">
                  <i></i><i></i><i></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="landing__sandbox" aria-label="Live sandbox credentials">
        <DemoCredentials />
      </section>
    </main>

    <style is:global>
      :root {
        --shamar-ember: #f1511b;
        --shamar-ember-deep: #c73d12;
        --shamar-ink: #0f172a;
        --shamar-sand: #f6f0e9;
        --shamar-mist: #e7ddd2;
        --font-display: 'Sora', ui-sans-serif, system-ui, sans-serif;
        --font-body: 'Figtree', ui-sans-serif, system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body.landing {
        font-family: var(--font-body);
        color: var(--shamar-ink);
        background: var(--shamar-sand);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .landing__atmosphere {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 70% 55% at 12% 18%, color-mix(in srgb, var(--shamar-ember) 30%, transparent), transparent 70%),
          radial-gradient(ellipse 55% 45% at 88% 8%, color-mix(in srgb, #286291 20%, transparent), transparent 68%),
          linear-gradient(165deg, #fbf7f2 0%, var(--shamar-sand) 48%, #e9e0d5 100%);
      }

      .landing__atmosphere::after {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.28;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/%3E%3C/svg%3E");
        mix-blend-mode: multiply;
      }

      body.landing > :not(.landing__atmosphere) {
        position: relative;
        z-index: 1;
      }

      .landing__hero {
        display: grid;
        gap: 2.5rem;
        align-items: center;
        min-height: calc(100vh - 5.5rem);
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem clamp(1.25rem, 4vw, 3rem) 2rem;
      }

      .landing__sandbox {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 4vw, 3rem) 3.5rem;
      }

      .landing__sandbox .shamar-demo-card {
        border: 1px solid color-mix(in srgb, var(--shamar-ink) 12%, transparent);
        border-radius: 1rem;
        padding: 1.25rem 1.35rem;
        background: color-mix(in srgb, #fff 78%, var(--shamar-mist));
        box-shadow: 0 18px 40px -28px rgba(15, 23, 42, 0.45);
      }

      .landing__sandbox .shamar-demo-card h3 {
        margin: 0 0 0.35rem;
        font-family: var(--font-display);
        font-size: 1.1rem;
        letter-spacing: -0.02em;
      }

      .landing__sandbox .shamar-demo-card p {
        margin: 0.25rem 0;
      }

      .landing__sandbox .shamar-demo-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        margin-top: 0.85rem;
        font-size: 0.92rem;
      }

      .landing__sandbox .shamar-countdown {
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        color: var(--shamar-ember-deep);
      }

      .landing__sandbox .shamar-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 1rem;
      }

      .landing__sandbox .shamar-demo-actions a {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.9rem;
        border-radius: 0.55rem;
        font-weight: 600;
        text-decoration: none;
        background: var(--shamar-ember);
        color: #fff;
      }

      .landing__sandbox .shamar-demo-actions a.secondary {
        background: transparent;
        color: var(--shamar-ember-deep);
        border: 1px solid color-mix(in srgb, var(--shamar-ink) 18%, transparent);
      }

      @media (min-width: 960px) {
        .landing__hero {
          grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
          gap: 3rem;
        }
      }

      .landing__brand {
        margin: 0 0 1.35rem;
        animation: rise 0.8s ease both;
      }

      .landing__brand img {
        display: block;
        width: min(100%, 18rem);
        height: auto;
        filter: drop-shadow(0 14px 28px color-mix(in srgb, var(--shamar-ember) 28%, transparent));
      }

      .landing__copy h1 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.15rem, 4.6vw, 3.4rem);
        line-height: 1.05;
        letter-spacing: -0.045em;
        max-width: 12ch;
        animation: rise 0.85s ease 0.08s both;
      }

      .landing__lede {
        margin: 1.15rem 0 0;
        max-width: 34ch;
        font-size: 1.18rem;
        line-height: 1.5;
        font-weight: 500;
        opacity: 0.86;
        animation: rise 0.85s ease 0.16s both;
      }

      .landing__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
        margin-top: 1.85rem;
        animation: rise 0.9s ease 0.24s both;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.2rem;
        border-radius: 0.6rem;
        font-family: var(--font-display);
        font-weight: 650;
        font-size: 0.92rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn--primary {
        background: var(--shamar-ember);
        color: #fff;
        box-shadow: 0 14px 28px -16px color-mix(in srgb, var(--shamar-ember) 80%, transparent);
      }

      .btn--ghost {
        color: var(--shamar-ink);
        border: 1px solid color-mix(in srgb, var(--shamar-ink) 18%, transparent);
        background: color-mix(in srgb, #fff 62%, transparent);
      }

      .btn--text {
        font-family: var(--font-body);
        color: var(--shamar-ember-deep);
        padding-inline: 0.35rem;
        font-weight: 650;
      }

      .landing__visual {
        animation: float-in 1.1s ease 0.2s both;
      }

      .landing__panel-frame {
        border-radius: 1.1rem;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--shamar-ink) 12%, transparent);
        background: color-mix(in srgb, #fff 82%, var(--shamar-mist));
        box-shadow:
          0 30px 60px -36px rgba(15, 23, 42, 0.5),
          0 0 0 1px color-mix(in srgb, #fff 40%, transparent) inset;
        transform: perspective(1200px) rotateY(-6deg) rotateX(4deg);
        transform-origin: left center;
      }

      .landing__panel-chrome {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.75rem 1rem;
        background: color-mix(in srgb, var(--shamar-mist) 70%, #fff);
        border-bottom: 1px solid color-mix(in srgb, var(--shamar-ink) 8%, transparent);
      }

      .landing__panel-chrome span {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--shamar-ink) 18%, transparent);
      }

      .landing__panel-chrome span:first-child {
        background: var(--shamar-ember);
      }

      .landing__panel-mark {
        margin-left: auto;
        height: 1.55rem;
        width: auto;
      }

      .landing__panel-body {
        display: grid;
        grid-template-columns: 0.32fr 0.68fr;
        min-height: 280px;
      }

      .landing__sidebar-skel {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        padding: 1rem 0.85rem;
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--shamar-ember) 12%, #fff),
          color-mix(in srgb, var(--shamar-mist) 80%, #fff)
        );
        border-right: 1px solid color-mix(in srgb, var(--shamar-ink) 8%, transparent);
      }

      .landing__sidebar-skel img {
        width: 2rem;
        height: 2rem;
        margin-bottom: 0.35rem;
      }

      .landing__sidebar-skel i {
        display: block;
        height: 0.55rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--shamar-ink) 12%, transparent);
        width: 78%;
      }

      .landing__sidebar-skel i:nth-child(3) {
        width: 62%;
      }

      .landing__sidebar-skel i:nth-child(4) {
        width: 70%;
      }

      .landing__main-skel {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .landing__row {
        height: 2.4rem;
        border-radius: 0.45rem;
        background: color-mix(in srgb, var(--shamar-ink) 7%, transparent);
        width: 72%;
      }

      .landing__row--wide {
        width: 92%;
        height: 7rem;
      }

      .landing__chips {
        display: flex;
        gap: 0.45rem;
        margin-top: auto;
      }

      .landing__chips i {
        display: block;
        width: 3.5rem;
        height: 1.35rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--shamar-ember) 28%, transparent);
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes float-in {
        from {
          opacity: 0;
          transform: translateY(24px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @media (max-width: 959px) {
        .landing__panel-frame {
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .landing__brand,
        .landing__copy h1,
        .landing__lede,
        .landing__ctas,
        .landing__visual {
          animation: none;
        }
      }
    </style>
  </body>
</html>
