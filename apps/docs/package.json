{
  "name": "@shamar/docs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Shamar framework documentation (Astro + Starlight)",
  "scripts": {
    "dev": "PUBLIC_DEMO_URL=${PUBLIC_DEMO_URL:-http://localhost:3333} astro dev --port 4321",
    "start": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "astro": "astro",
    "screenshots": "node scripts/capture-screenshots.mjs && node scripts/capture-component-screenshots.mjs",
    "screenshots:components": "node scripts/capture-component-screenshots.mjs",
    "reference": "node scripts/generate-reference.mjs"
  },
  "dependencies": {
    "@almasix/starlight-theme": "^0.1.1",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
